generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Единственная запись визитки (singleton). id — UUID v7, задаётся в seed.
model Profile {
  id          String       @id @db.Uuid
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]

  @@map("profiles")
}

model ProfileLink {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_links")
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  achievements String[]
  profileId    String    @db.Uuid
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String
  url       String
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}
