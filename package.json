{
  "name": "digital-business-card",
  "version": "1.0.0",
  "description": "GraphQL backend digital business card (NestJS + Prisma)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build && npm run build:seed",
    "build:seed": "tsc -p prisma/tsconfig.seed.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.10.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0",
    "lodash": "4.18.1",
    "qs": "6.17.0",
    "ws": "8.22.0",
    "subscriptions-transport-ws": {
      "ws": "7.5.13"
    },
    "deepmerge-ts": "8.0.2",
    "glob": "10.5.0",
    "tmp": "0.2.7",
    "file-type": "21.3.4",
    "@graphql-tools/utils": "12.0.4",
    "@apollo/server": {
      "uuid": "11.1.1"
    },
    "@nestjs/graphql": {
      "uuid": "11.1.1"
    },
    "@angular-devkit/core": {
      "ajv": "8.20.0",
      "picomatch": "4.0.7"
    }
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json --transpile-only prisma/seed.ts"
  }
}
